    {
      "parameters": {
        "jsCode": "// Parse the LLM response string into JSON object\nconst llmOutput = $input.item.json.text;\nlet classification = {};\ntry {\n  classification = JSON.parse(llmOutput.replace(/```json|```/g, ''));\n} catch(e) {\n  classification = { summary: llmOutput, intent: 'General', tags: [] };\n}\n\n// Get email data from the Clean HTML node - Fixed for n8n v1.122.4+\nconst emailData = $node['Clean HTML'].json;\n\n// Output specific fields for the Data Loader to pick up\nreturn {\n  json: {\n    pageContent: emailData.clean_text,\n    metadata: {\n      email_id: emailData.email_id,\n      subject: emailData.subject,\n      from: emailData.from,\n      date: emailData.internalDate,\n      intent: classification.intent,\n      summary: classification.summary,\n      tags: classification.tags || []\n    }\n  }\n};"
      },
