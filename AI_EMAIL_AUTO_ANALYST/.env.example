# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_ENCRYPTION_KEY=replace_with_long_random_string
TZ=UTC

# Qdrant
QDRANT_URL=https://b398780a-8990-4dc3-bb20-ccebf2ef4d91.europe-west3-0.gcp.cloud.qdrant.io:6333
QDRANT_COLLECTION=email_brain

# LLM (Groq OpenAI-compatible) OR OpenAI
GROQ_API_KEY=
# OPENAI_API_KEY=

# Hugging Face Inference
HF_API_TOKEN=

# Email (IMAP)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SSL=true
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=

# Postgres (for Chat Memory)
# Option A: Use Docker Postgres service (recommended)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tisha
POSTGRES_DB=Email_ai

# Option B: Use your local PC Postgres (outside Docker)
# n8n in Docker can reach Windows host via 'host.docker.internal'
# Uncomment and set these when NOT using the Docker Postgres service
# POSTGRES_EXTERNAL_HOST=host.docker.internal
# POSTGRES_EXTERNAL_PORT=5432
