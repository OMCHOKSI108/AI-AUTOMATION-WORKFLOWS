# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_ENCRYPTION_KEY=replace_with_long_random_string
TZ=UTC

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=email_brain

# LLM (Groq OpenAI-compatible) OR OpenAI
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face Inference (optional)
HF_API_TOKEN=your_huggingface_token_here

# Gmail (OAuth2 - for n8n Gmail node)
# Create OAuth2 credentials in Google Cloud Console
# Enable Gmail API and create OAuth2 client ID
GMAIL_CLIENT_ID=your_google_oauth2_client_id
GMAIL_CLIENT_SECRET=your_google_oauth2_client_secret
# The redirect URI should be: http://localhost:5678/rest/oauth2-credential/callback

# Postgres (for Chat Memory)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tisha
POSTGRES_DB=Email_ai

# Server
JWT_SECRET=my_super_secret_jwt_key_here_12345
PORT=4000
