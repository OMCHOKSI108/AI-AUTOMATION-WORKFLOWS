# Copy this file to .env and update values before running `docker-compose up -d`

# Basic auth (recommended for local testing)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Public webhook URL (if you expose n8n or use ngrok)
WEBHOOK_URL=http://localhost:5678/
